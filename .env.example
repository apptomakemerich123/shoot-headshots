# FAL storage — presigned uploads only (browser PUT → fal.media). Same format as before:
FAL_KEY="key_id:key_secret"

# Astria — fine-tune + image generation (https://api.astria.ai). Add in Vercel project env.
ASTRIA_API_KEY="sd_..."

# Public HTTPS origin Astria uses for tune + prompt callbacks (required locally / non-Vercel).
# On Vercel you can omit if VERCEL_URL is set; override with your production domain if needed.
# ASTRIA_WEBHOOK_BASE="https://www.yourdomain.com"

STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend — https://resend.com (ready email after headshots generate)
RESEND_API_KEY="re_..."

# Optional: origin for /results/[session_id] links in email (default https://www.getportr.com)
# EMAIL_RESULTS_ORIGIN="http://localhost:3000"

# Vercel KV (production). If unset, the app uses .data/portr-store.json on disk.
# Opt in to in-memory only: PORT_MEMORY_STORE_ONLY=1
