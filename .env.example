FAL_KEY="key_id:key_secret"

STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Public site URL for links in emails (production). Falls back to VERCEL_URL on Vercel.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Resend — https://resend.com (ready email after headshots generate)
RESEND_API_KEY="re_..."
# Optional; Resend onboarding sender works for testing only
# RESEND_FROM_EMAIL="Portr <onboarding@resend.dev>"

# Vercel KV (production). If unset, the app uses .data/portr-store.json on disk.
# Opt in to in-memory only: PORT_MEMORY_STORE_ONLY=1
